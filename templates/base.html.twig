<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <meta name="theme-color" content="#4a0e1f">
        <title>{% block title %}Dressing{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/logo-sombre-cintre.svg') }}" type="image/svg+xml">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block page %}
            <main class="ecran {% block ecran_classe %}{% endblock %}">
                {% for type, messages in app.flashes(['succes', 'erreur']) %}
                    {% for message in messages %}
                        <p class="flash flash--{{ type }}" role="{{ type == 'erreur' ? 'alert' : 'status' }}">{{ message }}</p>
                    {% endfor %}
                {% endfor %}
                {% block body %}{% endblock %}
            </main>
        {% endblock %}
    </body>
</html>
