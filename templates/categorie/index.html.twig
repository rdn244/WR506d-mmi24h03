{% extends 'app.html.twig' %}

{% block title %}Catégories · Dressing{% endblock %}
{% block ecran_classe %}ecran--liste{% endblock %}

{% block body %}
    <a href="{{ path('app_objets') }}" class="retour retour--avec-texte">{{ ux_icon('ph:arrow-left') }} Inventaire</a>

    <header class="entete-liste">
        <div class="entete-texte">
            <h1 class="titre titre--s">Catégories</h1>
            <p class="sous-titre sous-titre--s">Range ton inventaire par famille d'objets.</p>
        </div>
        {% if peut_creer_categorie() %}
            <a href="{{ path('app_categorie_nouvelle') }}" class="pastille pastille--primaire">{{ ux_icon('ph:plus-bold') }} Nouvelle</a>
        {% endif %}
    </header>

    <h2 class="etiquette-section">Mes catégories</h2>
    {% if perso is empty %}
        <p class="vide">
            Crée tes propres catégories (tenues de sport, souvenirs, collection…) en plus de celles proposées.
        </p>
    {% else %}
        <ul class="liste-cartes">
            {% for categorie in perso %}
                {% set nombre = comptes[categorie.id] ?? 0 %}
                <li class="carte-ligne">
                    <a href="{{ path('app_objets', {categorie: categorie.id}) }}" class="carte-ligne__icone carte-ligne__icone--s" aria-label="Voir les objets de {{ categorie.nom }}">
                        {{ ux_icon(categorie.icone) }}
                    </a>
                    <span class="carte-ligne__texte">
                        <span class="carte-ligne__titre carte-ligne__titre--s">{{ categorie.nom }}</span>
                        <span class="carte-ligne__detail">{{ nombre }} objet{{ nombre > 1 ? 's' }}</span>
                    </span>
                    {% if is_granted('MODIFIER', categorie) %}
                        <a href="{{ path('app_categorie_modifier', {id: categorie.id}) }}" class="bouton-icone" aria-label="Modifier {{ categorie.nom }}" title="Modifier">
                            {{ ux_icon('ph:pencil-simple') }}
                        </a>
                        <form method="post" action="{{ path('app_categorie_supprimer', {id: categorie.id}) }}"
                              data-turbo-confirm="Supprimer « {{ categorie.nom }} » ? Ses objets restent dans l'inventaire, sans catégorie.">
                            <input type="hidden" name="_token" value="{{ csrf_token('categorie') }}">
                            <button type="submit" class="bouton-icone bouton-icone--danger" aria-label="Supprimer {{ categorie.nom }}" title="Supprimer">
                                {{ ux_icon('ph:trash') }}
                            </button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <h2 class="etiquette-section">Proposées par Dressing</h2>
    <ul class="tuiles tuiles--categories">
        {% for categorie in predefinies %}
            {% set nombre = comptes[categorie.id] ?? 0 %}
            <li>
                <a href="{{ path('app_objets', {categorie: categorie.id}) }}" class="tuile {{ nombre == 0 ? 'tuile--vide' }}">
                    {{ ux_icon(categorie.icone, {class: 'tuile__icone'}) }}
                    <span class="tuile__nom">{{ categorie.nom }}</span>
                    <span class="tuile__detail">{{ nombre }} objet{{ nombre > 1 ? 's' }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
