{% extends 'app.html.twig' %}

{% block title %}Décris ton logement · Dressing{% endblock %}
{% block ecran_classe %}ecran--formulaire{% endblock %}

{% block body %}
    <a href="{{ path('app_accueil') }}" class="retour" aria-label="Retour">←</a>
    <h1 class="titre titre--m">Décris ton logement</h1>
    <p class="sous-titre sous-titre--s">Cela nous permet d'organiser ton inventaire par pièce.</p>

    {{ form_start(form, {attr: {class: 'formulaire', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.type, {attr: {class: 'puces'}}) }}
        {{ form_row(form.adresse) }}
        <div class="espaceur"></div>
        <button type="submit" class="bouton">Continuer</button>
    {{ form_end(form) }}
{% endblock %}
