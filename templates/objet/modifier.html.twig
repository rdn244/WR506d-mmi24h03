{% extends 'app.html.twig' %}

{% block title %}Modifier {{ objet.nom }} · Dressing{% endblock %}
{% block ecran_classe %}ecran--formulaire{% endblock %}

{% block body %}
    <a href="{{ path('app_objet_show', {id: objet.id}) }}" class="retour retour--avec-texte">{{ ux_icon('ph:arrow-left') }} {{ objet.nom }}</a>
    <h1 class="titre titre--m">Modifier la fiche</h1>

    {{ form_start(form, {attr: {class: 'formulaire', novalidate: 'novalidate'}}) }}
        {% if form.vars.errors|length > 0 %}
            <div class="erreurs--formulaire">{{ form_errors(form) }}</div>
        {% endif %}
        {{ include('objet/_champs.html.twig') }}
        <div class="espaceur"></div>
        <button type="submit" class="bouton">Enregistrer</button>
    {{ form_end(form) }}
{% endblock %}
