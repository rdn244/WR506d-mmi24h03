{% extends 'app.html.twig' %}

{% block title %}Profil · Dressing{% endblock %}
{% block ecran_classe %}ecran--avec-nav ecran--profil{% endblock %}

{% block body %}
    <header class="profil-entete">
        <img class="profil-entete__avatar" src="{{ asset('images/avatar.svg') }}" alt="" width="84" height="84">
        <h1 class="profil-entete__nom">{{ app.user.nomComplet }}</h1>
        <p class="profil-entete__email">{{ app.user.email }}</p>
    </header>

    <ul class="menu-profil">
        <li>
            <a href="{{ path('app_profil_parametres') }}" class="menu-profil__item">
                {{ ux_icon('ph:gear-six', {class: 'menu-profil__icone'}) }}<span class="menu-profil__libelle">Paramètres</span>{{ ux_icon('ph:caret-right', {class: 'menu-profil__chevron'}) }}
            </a>
        </li>
        <li>
            <a href="{{ path('app_logement') }}" class="menu-profil__item">
                {{ ux_icon('ph:house', {class: 'menu-profil__icone'}) }}<span class="menu-profil__libelle">Mon logement</span>{{ ux_icon('ph:caret-right', {class: 'menu-profil__chevron'}) }}
            </a>
        </li>
        {% for item in [
            {icone: 'ph:users', libelle: 'Gérer les sous-comptes'},
            {icone: 'ph:bell', libelle: 'Notifications'},
            {icone: 'ph:lifebuoy', libelle: 'Aide & support'},
            {icone: 'ph:lock-key', libelle: 'Confidentialité'},
        ] %}
            <li>
                <span class="menu-profil__item" aria-disabled="true" title="Bientôt disponible">
                    {{ ux_icon(item.icone, {class: 'menu-profil__icone'}) }}<span class="menu-profil__libelle">{{ item.libelle }}</span>{{ ux_icon('ph:caret-right', {class: 'menu-profil__chevron'}) }}
                </span>
            </li>
        {% endfor %}
        <li>
            <form method="post" action="{{ path('app_deconnexion') }}">
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                <button type="submit" class="menu-profil__item menu-profil__item--danger">
                    {{ ux_icon('ph:sign-out', {class: 'menu-profil__icone'}) }}<span class="menu-profil__libelle">Déconnexion</span>
                </button>
            </form>
        </li>
    </ul>

    <div class="espaceur"></div>
    {{ include('_partials/_nav.html.twig') }}
{% endblock %}
